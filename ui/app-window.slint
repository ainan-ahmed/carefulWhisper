// carefulWhisper — Main application window
// Thin shell that assembles the header, tab bar, pages, and overlays.

import { Theme }          from "theme.slint";
import { TranscriptItem,
         SettingsSTT, SettingsAudio, SettingsHotkey,
         SettingsOutput, SettingsPostprocess, SettingsLLM,
         SettingsGeneral } from "types.slint";
import { ConfirmDialog }  from "components/confirm-dialog.slint";
import { Snackbar }       from "components/snackbar.slint";
import { HomePage }       from "pages/home-page.slint";
import { HistoryPage }    from "pages/history-page.slint";
import { SettingsPage }   from "pages/settings-page.slint";

export { TranscriptItem, SettingsSTT, SettingsAudio, SettingsHotkey,
         SettingsOutput, SettingsPostprocess, SettingsLLM, SettingsGeneral }

export component AppWindow inherits Window {
    title: "carefulWhisper";
    preferred-width: 480px;
    preferred-height: 640px;
    min-width: 400px;
    min-height: 500px;
    background: Theme.bg;

    // ── Properties (bound from Python) ───────────────────────────────────
    in property <[TranscriptItem]> history: [];
    in property <int> total-count: 0;
    in property <string> recording-status: "idle";

    // ── Settings properties ──────────────────────────────────────────────
    in-out property <SettingsSTT>         settings-stt;
    in-out property <SettingsAudio>       settings-audio;
    in-out property <SettingsHotkey>      settings-hotkey;
    in-out property <SettingsOutput>      settings-output;
    in-out property <SettingsPostprocess> settings-postprocess;
    in-out property <SettingsLLM>         settings-llm;
    in-out property <SettingsGeneral>     settings-general;

    // ── Snackbar properties ──────────────────────────────────────────────
    in-out property <bool>   snackbar-visible: false;
    in-out property <string> snackbar-message: "";
    in-out property <bool>   snackbar-is-error: false;

    // ── Internal state ───────────────────────────────────────────────────
    in-out property <int>  active-tab: 0;
    in-out property <bool> show-confirm-dialog: false;
    in-out property <int>  pending-delete-id: -1;

    // ── Callbacks (handled in Python) ────────────────────────────────────
    callback search-changed(string);
    callback copy-transcript(int);
    callback confirm-delete(int);
    callback toggle-recording();

    // Settings callbacks
    callback save-stt-settings(SettingsSTT);
    callback save-audio-settings(SettingsAudio);
    callback save-hotkey-settings(SettingsHotkey);
    callback save-output-settings(SettingsOutput);
    callback save-postprocess-settings(SettingsPostprocess);
    callback save-llm-settings(SettingsLLM);
    callback save-general-settings(SettingsGeneral);
    callback reset-all-settings();

    // ── Layout ───────────────────────────────────────────────────────────

    VerticalLayout {
        padding: 0;
        spacing: 0;

        // Header
        Rectangle {
            height: 56px;
            background: Theme.bg;

            HorizontalLayout {
                alignment: center;
                padding-top: 16px;
                padding-bottom: 8px;

                Text {
                    text: "careful";
                    color: Theme.text-primary;
                    font-size: 20px;
                    font-weight: 300;
                }

                Text {
                    text: "Whisper";
                    color: Theme.accent;
                    font-size: 20px;
                    font-weight: 700;
                }
            }
        }

        // Tab bar
        Rectangle {
            height: 40px;
            background: Theme.bg;

            HorizontalLayout {
                alignment: center;
                spacing: 0;

                for tab[i] in [
                    { label: "Home" },
                    { label: "History" },
                    { label: "Settings" },
                ] : Rectangle {
                    width: 100px;
                    height: 40px;

                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.active-tab = i; }
                    }

                    VerticalLayout {
                        alignment: end;

                        Text {
                            text: tab.label;
                            color: root.active-tab == i
                                ? Theme.accent : Theme.text-muted;
                            font-size: 14px;
                            font-weight: root.active-tab == i ? 600 : 400;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            height: 2px;
                            width: parent.width * 0.6;
                            x: (parent.width - self.width) / 2;
                            background: root.active-tab == i
                                ? Theme.accent : transparent;
                            border-radius: 1px;
                            animate background { duration: 200ms; }
                        }
                    }
                }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        // ── Pages ────────────────────────────────────────────────────────

        Rectangle {
            if root.active-tab == 0 : HomePage {
                recording-status: root.recording-status;
                toggle-recording => { root.toggle-recording(); }
            }

            if root.active-tab == 1 : HistoryPage {
                history:     root.history;
                total-count: root.total-count;
                recording-status: root.recording-status;

                search-changed(q)  => { root.search-changed(q); }
                copy-clicked(id)   => { root.copy-transcript(id); }
                delete-clicked(id) => {
                    root.pending-delete-id = id;
                    root.show-confirm-dialog = true;
                }
            }

            if root.active-tab == 2 : SettingsPage {
                stt:         root.settings-stt;
                audio:       root.settings-audio;
                hotkey:      root.settings-hotkey;
                output:      root.settings-output;
                postprocess: root.settings-postprocess;
                llm:         root.settings-llm;
                general:     root.settings-general;

                save-stt(v)         => { root.save-stt-settings(v); }
                save-audio(v)       => { root.save-audio-settings(v); }
                save-hotkey(v)      => { root.save-hotkey-settings(v); }
                save-output(v)      => { root.save-output-settings(v); }
                save-postprocess(v) => { root.save-postprocess-settings(v); }
                save-llm(v)         => { root.save-llm-settings(v); }
                save-general(v)     => { root.save-general-settings(v); }
                reset-all()         => { root.reset-all-settings(); }
            }
        }
    }

    // ── Delete confirmation overlay ──────────────────────────────────────

    if root.show-confirm-dialog : ConfirmDialog {
        confirmed => {
            root.confirm-delete(root.pending-delete-id);
            root.show-confirm-dialog = false;
            root.pending-delete-id = -1;
        }

        cancelled => {
            root.show-confirm-dialog = false;
            root.pending-delete-id = -1;
        }
    }

    // ── Snackbar overlay ─────────────────────────────────────────────────

    Snackbar {
        show: root.snackbar-visible;
        message: root.snackbar-message;
        is-error: root.snackbar-is-error;
    }
}
