// carefulWhisper — Shared design tokens
// Import this in any component that needs consistent theming.

export global Theme {
    out property <color> bg:               #1a1b2e;
    out property <color> surface:          #252640;
    out property <color> surface-hover:    #2e2f4a;
    out property <color> accent:           #7c5cbf;
    out property <color> accent-dim:       #5a4290;
    out property <color> text-primary:     #e8e8ef;
    out property <color> text-muted:       #6b6b80;
    out property <color> text-hint:        #4a4a5e;
    out property <color> destructive:      #cf4444;
    out property <color> destructive-hover:#e05555;
    out property <color> border:           #33344a;
    out property <color> overlay:          #000000cc;
}
