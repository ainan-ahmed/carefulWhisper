// carefulWhisper — Snackbar notification overlay
// Floating bar at the bottom of the window for save/error feedback.

import { Theme } from "../theme.slint";

export component Snackbar inherits Rectangle {
    in property <string> message: "";
    in property <bool> is-error: false;
    in property <bool> show: false;

    width: 100%;
    height: 100%;
    background: transparent;

    // Floating bar
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.show
            ? parent.height - self.height - 16px
            : parent.height + 10px;
        width: min(360px, parent.width - 48px);
        height: 44px;
        border-radius: 10px;
        background: root.is-error ? #3a1c1c : #1c3a1e;
        border-width: 1px;
        border-color: root.is-error ? Theme.destructive : Theme.success;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000066;

        animate y { duration: 280ms; easing: ease-out; }

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 10px;
            alignment: center;

            Text {
                text: root.is-error ? "✗" : "✓";
                color: root.is-error ? Theme.destructive : Theme.success;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: root.message;
                color: Theme.text-primary;
                font-size: 13px;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
